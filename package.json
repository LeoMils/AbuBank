{
  "name": "abu-bank",
  "private": true,
  "version": "30.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "node scripts/dev-https.cjs",
    "gen:cert": "node scripts/generate-dev-cert.cjs",
    "prepare": "node scripts/setup-git-hooks.cjs",
    "generate:memory": "npx tsx scripts/generate-memory-from-knowledge.ts",
    "generate:knowledge": "npx tsx scripts/generate-family-people.ts",
    "validate:family": "npx tsx scripts/validate-family-data.ts",
    "validate:knowledge": "npx tsx scripts/validate-knowledge.ts",
    "validate:people": "npx tsx scripts/validate-people.ts",
    "prebuild": "npm run generate:memory && npm run generate:knowledge && npm run validate:family && npm run validate:knowledge && npm run validate:people",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rc:verify": "npx tsx scripts/rc-verify.ts",
    "qa:text-harness": "npx tsx scripts/text-harness-report.ts",
    "eval:behavior": "npx vite-node scripts/eval/report.ts",
    "qa:production-gate": "npx tsx scripts/text-harness-report.ts && npx tsx scripts/qa-production-gate.ts",
    "qa:seal": "node scripts/seal-scorecard.mjs",
    "abu:goal:arm": "node scripts/abu-goal.mjs arm",
    "abu:goal:status": "node scripts/abu-goal.mjs status",
    "abu:goal:disarm": "node scripts/abu-goal.mjs disarm",
    "check": "tsc --noEmit && vitest run",
    "workbench": "node scripts/ai-workbench.js",
    "qa:production-verdict": "npx tsx scripts/qa-production-verdict.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@phosphor-icons/react": "^2.1.7",
    "@types/ws": "^8.18.1",
    "edge-tts": "^1.0.1",
    "idb": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite-plugin-pwa": "^0.21.1",
    "ws": "^8.20.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.14",
    "vitest": "^4.1.4"
  }
}
