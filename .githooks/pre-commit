#!/bin/sh
#
# Fast pre-commit (fast commits, strict releases).
# Delegates to scripts/precommit-guard.cjs: staged-file inventory, privacy/secret
# scan, version-contract consistency, and family validation ONLY when family data
# is staged. The FULL test suite is a RELEASE/CI gate, NOT a per-commit gate —
# see docs/engineering-os/RELEASE_TEST_STRATEGY.md.
#
# Setup: git config core.hooksPath .githooks   (or `npm run prepare`)
# Bypass (rare, intentional): git commit --no-verify   |   ABU_HOOKS_DISABLE=1
#
node scripts/precommit-guard.cjs
exit $?
